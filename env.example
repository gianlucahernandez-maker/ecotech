# Copie este archivo como ".env" y ajuste los valores de su equipo.
# El archivo .env NUNCA se sube a Git (está en .gitignore).

# Ruta del archivo SQLite (relativa a la carpeta del proyecto o absoluta)
ECOTECH_DB_PATH=datos/ecotech.db

# Si en el futuro se migra a PostgreSQL / Supabase, las credenciales irían aquí:
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
